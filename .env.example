# Bedrock (seeon-meet 과 같은 키). 공장 실행은 SEEON_JUDGE_BACKEND=bedrock 일 때만 Bedrock 을 부른다(gpu 기본이면 비워 둬도 된다).
AWS_BEARER_TOKEN_BEDROCK=
SEEON_BEDROCK_REGION=
SEEON_BEDROCK_MODEL_ID=
SEEON_BEDROCK_JUDGE_MODEL_ID=
# GPU 서비스 주소(기본 127.0.0.1:8801 VLM · 8802 ASR · 8803 TTS · 8804 EMBED)
SEEON_VLM_URL=
# 모델 이름은 GPU 서버의 서빙 이름(--served-model-name)과 같아야 한다. 시작 전 점검이 /v1/models 로 확인하고, 다르면 멈춘다.
# 비우면 서브모듈 제품 기본값을 쓴다. 지금 서버는 VLM(8801)·판정(8805) 모두 gemma-4-26b-a4b-qat 를 서빙하고 제품 기본값도 같은 이름이라 비워 둔다.
SEEON_VLM_MODEL=
# VLM 그림 한 장의 이미지 토큰 수 상한(해상도). 비우면 서버에 띄운 값. 서버가 --trust-request-mm-kwargs 로 떠 있을 때만 넣는다(아니면 그림 요청이 400 으로 모두 실패)
SEEON_VLM_MAX_SOFT_TOKENS=
SEEON_ASR_URL=
SEEON_TTS_URL=
SEEON_TTS_LONG_URL=
SEEON_EMBED_URL=
SEEON_ROUTER_MODE=
# 척도 해설은 기본 켬. false 로만 끈다
SEEON_ROUTER_SCALE_ENABLED=
# 탐지 판정 LLM(기본 gpu: GPU 서버에서 VLM 과 따로 띄운 127.0.0.1:8805, 실패해도 Bedrock 으로 넘기지 않는다. bedrock 이면 SEEON_BEDROCK_JUDGE_MODEL_ID)
# 삽입 위치 추론은 판정 백엔드와 상관없이 이 GPU 판정 LLM 을 쓴다. SEEON_JUDGE_GPU_MODEL 이름은 위 SEEON_VLM_MODEL 설명과 같다
SEEON_JUDGE_BACKEND=
SEEON_JUDGE_GPU_URL=
SEEON_JUDGE_GPU_MODEL=
# 슬라이드 전사 백엔드(기본 vlm, ocr 이면 임베딩 서비스의 /ocr). OCR 주소는 기본 임베딩 origin + /ocr 이라 포트를 나눴을 때만 준다
SEEON_SLIDE_TEXT_BACKEND=
SEEON_OCR_URL=
# 수치 해설(변화·비교)과 척도 해설에 그 프레임을 OCR 로 읽은 글자를 근거로 넣는다. 기본 on, off 로 끈다(슬라이드 전사 백엔드와 상관없이 위 OCR 주소를 쓴다)
SEEON_SCREEN_TEXT_GROUNDING=
# 틈 후보 출처: 공장은 asr(기본)만 지원한다. audio 를 주면 시작 전 점검이 멈춘다
SEEON_GAP_SOURCE=
# GPU 터널 폴백(포트가 닫혀 있을 때만). 제품에 서버 기본값이 없어 키와 HOST·USER·HOST_FINGERPRINT 를 모두 넣어야 열린다(PORT 는 비우면 22)
SEEON_GPU_TUNNEL=
SEEON_GPU_SSH_KEY=
SEEON_GPU_SSH_HOST=
SEEON_GPU_SSH_PORT=
SEEON_GPU_SSH_USER=
SEEON_GPU_SSH_HOST_FINGERPRINT=
# ffmpeg 경로(없으면 PATH)
SEEON_FACTORY_FFMPEG=
SEEON_FACTORY_FFPROBE=
# 한국어 트리거 형태소 분석 모델(Kiwi)은 환경변수가 아니라 npm --prefix seeon-meet run setup:kiwi 로 seeon-meet/vendor/kiwi-model 에 받는다
