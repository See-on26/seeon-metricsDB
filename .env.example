# Bedrock (seeon-meet 과 같은 키)
AWS_BEARER_TOKEN_BEDROCK=
SEEON_BEDROCK_REGION=
SEEON_BEDROCK_MODEL_ID=
SEEON_BEDROCK_JUDGE_MODEL_ID=
SEEON_BEDROCK_GAP_BALANCED_MODEL_ID=
SEEON_BEDROCK_VLM_FALLBACK_MODEL_ID=
SEEON_VLM_FALLBACK_ENABLED=
# GPU 서비스 주소(기본 127.0.0.1:8801 VLM · 8802 ASR · 8803 TTS · 8804 EMBED)
SEEON_VLM_URL=
# 모델 이름은 GPU 서버의 서빙 이름(--served-model-name)과 같아야 한다. 시작 전 점검이 /v1/models 로 확인하고, 다르면 멈춘다.
# 지금 서버는 VLM(8801)·판정(8805) 모두 gemma-4-26b-a4b-qat 를 서빙한다. 비우면 서브모듈 제품 기본값을 쓰는데, 161ebfe 는 아직 qwen3.5-35b-a3b·qwen3.5-9b 다.
# 예: SEEON_VLM_MODEL=gemma-4-26b-a4b-qat
SEEON_VLM_MODEL=
SEEON_ASR_URL=
SEEON_TTS_URL=
SEEON_TTS_LONG_URL=
SEEON_EMBED_URL=
SEEON_ROUTER_MODE=
# 척도 해설은 기본 켬. false 로만 끈다
SEEON_ROUTER_SCALE_ENABLED=
# 탐지 판정 LLM(기본 gpu: GPU 서버에서 VLM 과 따로 띄운 127.0.0.1:8805, 실패하면 Bedrock 판정 모델)
# 예: SEEON_JUDGE_GPU_MODEL=gemma-4-26b-a4b-qat (이름은 위 SEEON_VLM_MODEL 설명과 같다)
SEEON_JUDGE_BACKEND=
SEEON_JUDGE_GPU_URL=
SEEON_JUDGE_GPU_MODEL=
# 슬라이드 전사 백엔드(기본 vlm, ocr 이면 임베딩 서비스의 /ocr). OCR 주소는 기본 임베딩 origin + /ocr 이라 포트를 나눴을 때만 준다
SEEON_SLIDE_TEXT_BACKEND=
SEEON_OCR_URL=
# 틈 후보 출처: 공장은 asr(기본)만 지원한다. audio 를 주면 시작 전 점검이 멈춘다
SEEON_GAP_SOURCE=
# GPU 터널 폴백(포트가 닫혀 있을 때만)
SEEON_GPU_TUNNEL=
SEEON_GPU_SSH_KEY=
SEEON_GPU_SSH_HOST=
SEEON_GPU_SSH_PORT=
SEEON_GPU_SSH_USER=
SEEON_GPU_SSH_HOST_FINGERPRINT=
# ffmpeg 경로(없으면 PATH)
SEEON_FACTORY_FFMPEG=
SEEON_FACTORY_FFPROBE=
# 한국어 트리거 형태소 분석 모델(Kiwi)은 환경변수가 아니라 npm --prefix seeon-meet run setup:kiwi 로 seeon-meet/vendor/kiwi-model 에 받는다
